
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Homiva</title>
    <link rel="stylesheet" href="/css/admin-login.css">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
</head>
<body>

    <main class="login-page">

        <!-- LEFT IMAGE SECTION -->
        <section class="visual-section">
            <a href="/" class="brand-logo">homiva<span>.</span></a>

            <div class="visual-image">
                <img
                    src="/images/hero-living-room.jpg"
                    alt="Homiva neutral living room"
                >
                <div class="image-overlay"></div>

                <div class="visual-caption">
                    <p class="eyebrow">THE ART OF LIVING WELL</p>
                    <h1>Beautiful spaces.<br>Meaningful living.</h1>
                    <p>Thoughtful details make a house feel like home.</p>
                </div>
            </div>

            <p class="visual-footer">© 2026 HOMIVA LIVING</p>
        </section>

        <!-- RIGHT LOGIN SECTION -->
        <section class="form-section">
            <div class="login-card">

                <div class="mobile-logo">
                    homiva<span>.</span>
                </div>

                <p class="eyebrow">ADMINISTRATION</p>
                <h2>Welcome <em>back.</em></h2>

                <p class="form-description">
                    Sign in to manage your Homiva store.
                </p>

                <form id="adminLoginForm">

                    <div class="form-group">
                        <label for="email">Email address</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="admin@homiva.com"
                            autocomplete="username"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <div class="password-label">
                            <label for="password">Password</label>
                        </div>

                        <div class="password-wrapper">
                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Enter your password"
                                autocomplete="current-password"
                                required
                            >

                            <button
                                type="button"
                                id="togglePassword"
                                class="toggle-password"
                                aria-label="Show password"
                            >
                                Show
                            </button>
                        </div>
                    </div>

                    <div class="form-options">
                        <label class="remember-label">
                            <input type="checkbox" name="rememberMe">
                            <span>Remember me</span>
                        </label>
                    </div>

                    <p id="loginMessage" class="login-message" role="alert"></p>

                    <button type="submit" class="login-button">
                        Sign in to dashboard <span>↗</span>
                    </button>

                </form>

                <div class="security-note">
                    <span>◇</span>
                    <p>Restricted access. Authorized administrators only.</p>
                </div>

                <a href="/" class="back-link">← Back to Homiva store</a>

            </div>
        </section>

    </main>
<script src="/js/admin-login.js" defer></script>
</body>
</html>
