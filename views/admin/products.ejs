
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Products | Homiva</title>

    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <link rel="stylesheet" href="/css/admin-products.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
</head>

<body>

<div class="admin-layout">

    <!-- Sidebar -->
    <aside class="sidebar">

        <a href="/admin/dashboard" class="brand">
            <span class="brand-icon">⌂</span>
            <span class="brand-name">Homiva</span>
            <small>HOME DECOR</small>
        </a>

         <nav class="sidebar-nav">
                <a href="/admin/dashboard" class="nav-link">⌂ <span>Dashboard</span></a>
                <a href="/admin/products" class="nav-link active">◇ <span>Products</span></a>
                <a href="/admin/orders" class="nav-link">🛒 <span>Orders</span></a>
                <a href="/admin/users-page" class="nav-link">♙ <span>Users</span></a>
                <a href="/admin/coupons" class="nav-link">▦ <span>Coupons</span></a>
            </nav>

        <form action="/admin/logout" method="POST" class="logout-form">
            <button type="submit" class="logout-link">
                ↪ <span>Logout</span>
            </button>
        </form>

    </aside>

    <!-- Main Content -->
    <main class="main-content">

        <header class="topbar">

            <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
                ☰
            </button>

            <!-- Product Search -->
            <div class="search-box">
                <span>⌕</span>
                <input
                    type="search"
                    id="productSearch"
                    placeholder="Search products..."
                    aria-label="Search products"
                >
            </div>

            <div class="admin-profile">
                <span class="avatar">A</span>
                <span>Admin</span>
            </div>

        </header>

        <section class="products-content">

            <div class="products-heading">
                <div>
                    <h1>Manage Products</h1>
                    <p>View and manage your Homiva products</p>
                </div>

                <a href="/admin/products/new" class="add-product-btn">
                    + Add Product
                </a>
            </div>

            <!-- Product List -->
            <section class="product-list-section">

                <div class="product-list-header">
                    <h2>All Products</h2>
                    <p>Manage your Homiva products</p>
                </div>

                <% if (success === "1") { %>
                    <p class="success-message">
                        Product added successfully!
                    </p>
                <% } %>

                <div class="table-container">

                    <table class="products-table" id="productsTable">

                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody id="productsTableBody">

                            <% if (products && products.length > 0) { %>

                                <% products.forEach(product => { %>

                                    <tr>
                                        <td>
                                            <img
                                                src="<%= product.image %>"
                                                alt="<%= product.name %>"
                                                class="product-thumbnail"
                                            >
                                        </td>

                                        <td><%= product.name %></td>

                                        <td><%= product.category %></td>

                                        <td>₹<%= product.price %></td>

                                        <td><%= product.stock %></td>

                                        <td class="action-buttons">

                                            <a
                                                href="/admin/products/<%= product._id %>/edit"
                                                class="edit-btn"
                                            >
                                                Edit
                                            </a>

                                            <form
                                                action="/admin/products/<%= product._id %>/delete"
                                                method="POST"
                                                onsubmit="return confirm('Are you sure you want to delete this product?')"
                                            >
                                                <button
                                                    type="submit"
                                                    class="delete-btn"
                                                >
                                                    Delete
                                                </button>
                                            </form>

                                        </td>
                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>
                                    <td colspan="6" class="empty-message">
                                        No products found.
                                    </td>
                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </section>

        </section>

    </main>

</div>

<script>
    // Mobile sidebar toggle
    document.getElementById("menuToggle").addEventListener("click", () => {
        document.querySelector(".sidebar").classList.toggle("sidebar-open");
    });

    // Product search
    const productSearch = document.getElementById("productSearch");
    const productsTableBody = document.getElementById("productsTableBody");

    let searchTimeout;

    productSearch.addEventListener("input", function () {
        clearTimeout(searchTimeout);

        searchTimeout = setTimeout(() => {
            searchAdminProducts(productSearch.value.trim());
        }, 300);
    });

    async function searchAdminProducts(searchText) {
        try {
            const response = await fetch(
                `/admin/products/search?search=${encodeURIComponent(searchText)}`
            );

            const result = await response.json();

            if (!response.ok || !result.success) {
                throw new Error(result.message || "Product search failed");
            }

            renderProducts(result.data);

        } catch (error) {
            console.error("Product search error:", error);

            productsTableBody.innerHTML = `
                <tr>
                    <td colspan="6" class="empty-message">
                        Unable to search products. Please try again.
                    </td>
                </tr>
            `;
        }
    }

    // Display search results
    function renderProducts(products) {
        productsTableBody.innerHTML = "";

        if (!products || products.length === 0) {
            productsTableBody.innerHTML = `
                <tr>
                    <td colspan="6" class="empty-message">
                        No matching products found.
                    </td>
                </tr>
            `;
            return;
        }

        products.forEach(product => {
            const row = document.createElement("tr");

            const imageCell = document.createElement("td");
            const image = document.createElement("img");

            image.src = product.image || "";
            image.alt = product.name || "Product";
            image.className = "product-thumbnail";

            imageCell.appendChild(image);

            const nameCell = document.createElement("td");
            nameCell.textContent = product.name || "";

            const categoryCell = document.createElement("td");
            categoryCell.textContent = product.category || "";

            const priceCell = document.createElement("td");
            priceCell.textContent = `₹${product.price ?? 0}`;

            const stockCell = document.createElement("td");
            stockCell.textContent = product.stock ?? 0;

            const actionsCell = document.createElement("td");
            actionsCell.className = "action-buttons";

            const editLink = document.createElement("a");
            editLink.href = `/admin/products/${encodeURIComponent(product._id)}/edit`;
            editLink.className = "edit-btn";
            editLink.textContent = "Edit";

            const deleteForm = document.createElement("form");
            deleteForm.action = `/admin/products/${encodeURIComponent(product._id)}/delete`;
            deleteForm.method = "POST";

            deleteForm.addEventListener("submit", event => {
                if (!confirm("Are you sure you want to delete this product?")) {
                    event.preventDefault();
                }
            });

            const deleteButton = document.createElement("button");
            deleteButton.type = "submit";
            deleteButton.className = "delete-btn";
            deleteButton.textContent = "Delete";

            deleteForm.appendChild(deleteButton);

            actionsCell.appendChild(editLink);
            actionsCell.appendChild(deleteForm);

            row.append(
                imageCell,
                nameCell,
                categoryCell,
                priceCell,
                stockCell,
                actionsCell
            );

            productsTableBody.appendChild(row);
        });
    }
</script>

</body>
</html>
