<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Discover timeless home decor and living essentials at Homiva.">
    <title>Homiva | Make Yourself at Home</title>

    <link rel="stylesheet" href="/css/home.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
</head>

<body>

   <%- include("../partials/header", { user: user }) %>

    <!-- SEARCH -->
    <section class="search-section">
        <form class="search-bar" action="/products" method="GET">
            <svg viewBox="0 0 24 24">
                <circle cx="10.8" cy="10.8" r="6.3"/>
                <path d="m16 16 4 4"/>
            </svg>

            <input
                type="search"
                name="search"
                placeholder="What makes your house feel like home?"
                aria-label="Search products"
            >

            <button type="submit">Search</button>
        </form>
    </section>

    <main>

        <!-- HERO -->
        <section class="hero-section">
            <div class="hero-content">
                <p class="eyebrow">THOUGHTFULLY MADE FOR LIVING</p>

                <h1>Make your home<br>feel like <em>you.</em></h1>

                <p class="hero-description">
                    A little warmth, a little character, and pieces that make
                    every corner feel special. Find your kind of beautiful
                    with Homiva.
                </p>

                <a href="/products" class="primary-button">
                    Explore the collection <span>↗</span>
                </a>

                <div class="hero-note">
                    <span></span>
                    Thoughtful details. Everyday comfort.
                </div>
            </div>

            <div class="hero-image">
                <img
                    src="/images/hero-living-room.jpg"
                    alt="Neutral living room with natural textures"
                >
                <div class="image-caption">SLOW LIVING, BEAUTIFULLY DONE</div>
            </div>
        </section>

        <!-- BRAND PROMISE -->
        <section class="promise-strip">
            <div class="promise-item">
                <span class="promise-symbol">✳</span>
                <div>
                    <h3>Thoughtfully Curated</h3>
                    <p>Pieces chosen with purpose</p>
                </div>
            </div>

            <div class="promise-item">
                <span class="promise-symbol">◇</span>
                <div>
                    <h3>Timeless by Nature</h3>
                    <p>Made to feel at home anywhere</p>
                </div>
            </div>

            <div class="promise-item">
                <span class="promise-symbol">♡</span>
                <div>
                    <h3>Little Things, Big Feelings</h3>
                    <p>Everyday moments made special</p>
                </div>
            </div>
        </section>

        <!-- CATEGORIES -->
        <section class="categories-section" id="categories">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">MAKE SPACE FOR BEAUTY</p>
                    <h2>Find your little something.</h2>
                    <p class="section-description">
                        Pieces that bring your space together, naturally.
                    </p>
                </div>

                <a href="/products" class="text-link">
                    Shop all categories ↗
                </a>
            </div>

            <div class="category-grid">

                <a href="/products?category=decorative-items" class="category-card">
                    <div class="category-image">
                        <img
                            src="/images/decor-objects.jpg"
                            alt="Decorative home accessories"
                            loading="lazy"
                        >
                        <span class="category-arrow">↗</span>
                    </div>
                    <h3>Decor &amp; Objects</h3>
                    <p>Little details, lasting impressions</p>
                </a>

                <a href="/products?category=lighting" class="category-card">
                    <div class="category-image">
                        <img
                            src="/images/lighting.jpg"
                            alt="Minimal decorative lighting"
                            loading="lazy"
                        >
                        <span class="category-arrow">↗</span>
                    </div>
                    <h3>Lighting</h3>
                    <p>Set the mood, softly</p>
                </a>

                <a href="/products?category=wall-decor" class="category-card">
                    <div class="category-image">
                        <img
                            src="/images/wall-decor.jpg"
                            alt="Minimal wall art and home decor"
                            loading="lazy"
                        >
                        <span class="category-arrow">↗</span>
                    </div>
                    <h3>Wall Decor</h3>
                    <p>Give your walls a story</p>
                </a>

                <a href="/products?category=furnishings" class="category-card">
                    <div class="category-image">
                        <img
                            src="/images/soft-furnishings.jpg"
                            alt="Soft neutral home furnishings"
                            loading="lazy"
                        >
                        <span class="category-arrow">↗</span>
                    </div>
                    <h3>Soft Furnishings</h3>
                    <p>Comfort in every layer</p>
                </a>

                <a href="/products?category=plants" class="category-card">
                    <div class="category-image">
                        <img
                            src="/images/plants-planters.jpg"
                            alt="Indoor plants and planters"
                            loading="lazy"
                        >
                        <span class="category-arrow">↗</span>
                    </div>
                    <h3>Plants &amp; Planters</h3>
                    <p>A little nature, indoors</p>
                </a>

            </div>
        </section>

        <!-- FEATURED PRODUCTS -->
        <section class="featured-section" id="featured">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">A FEW THINGS WE LOVE</p>
                    <h2>Lovely things for living.</h2>
                    <p class="section-description">
                        Everyday essentials with a little extra soul.
                    </p>
                </div>

                <a href="/products" class="text-link">
                    View all products ↗
                </a>
            </div>

            <div class="product-grid" id="featuredProducts">
    <p class="loading-message">Loading products...</p>
</div>
        </section>

        <!-- ABOUT HOMIVA -->
        <section class="about-section" id="about">
            <div class="about-image">
                <img
                    src="/images/about-dining-room.jpg"
                    alt="Calm, neutral dining room interior"
                    loading="lazy"
                >
            </div>

            <div class="about-content">
                <p class="eyebrow">A HOME THAT FEELS LIKE YOURS</p>

                <h2>
                    It's not just how it looks.
                    It's how it <em>feels.</em>
                </h2>

                <p>
                    We believe a home comes together in the little things:
                    the warm glow of a lamp, a favourite vase, a soft throw
                    on a quiet evening. Homiva is here to help you find
                    those pieces.
                </p>

                <a href="/products" class="text-link">
                    Find your pieces ↗
                </a>
            </div>
        </section>

    </main>
<%- include("../partials/footer") %>
  <script src="/js/customer-home.js"></script>
  </body>
</html>