  
  <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Discover timeless home decor and living essentials at Homiva.">
    <title>My Cart | Homiva</title>

    <link rel="stylesheet" href="/css/home.css">
     <link rel="stylesheet" href="/css/cart.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
</head>

<body>
<%- include("../partials/header", { user: user }) %>

    
<main class="cart-page">
    <div class="cart-container">

        <section class="cart-items-section">
            <div class="cart-heading">
                <h1>Your Cart</h1>
                <p id="cart-item-count">0 items</p>
            </div>

            <div id="cart-items">
                <!-- Cart products will be loaded here -->
            </div>

            <a href="/products" class="continue-shopping">
                ← Continue Shopping
            </a>
        </section>

        <aside class="cart-summary">
            <h2>Order Summary</h2>

            <div class="summary-row">
                <span>Subtotal</span>
                <span id="cart-subtotal">₹0.00</span>
            </div>

            <div class="summary-row">
                <span>Shipping</span>
                <span id="cart-shipping">₹0.00</span>
            </div>

            <div class="coupon-section">
                <label for="coupon-code">Coupon Code</label>

                <div class="coupon-input-group">
                    <input
                        type="text"
                        id="coupon-code"
                        placeholder="Enter coupon code"
                    >
                    <button type="button" id="apply-coupon">
                        Apply
                    </button>
                </div>

                <p id="coupon-message"></p>
            </div>
            <div id="available-coupons"></div>

            <div class="summary-row discount-row">
                <span>Discount</span>
                <span id="cart-discount">-₹0.00</span>
            </div>

            <div class="summary-row total-row">
                <span>Total</span>
                <span id="cart-total">₹0.00</span>
            </div>

            <button type="button" id="checkout-btn">
                Proceed to Checkout
            </button>
        </aside>

    </div>
</main>
  <%- include("../partials/footer") %>
  
  <script src="/js/cart.js"></script>

</body>
</html>